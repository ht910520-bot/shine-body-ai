# Cloudflare Workers AI is the food-analysis provider. Photo and text requests
# fail closed when the account id or API token is missing. Set these four
# names on Vercel. Do not commit a real token. CF_ACCOUNT_ID and CF_API_TOKEN
# are accepted aliases for the first two.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"
# Photo analysis. One call to Llama 3.2 11B Vision, 50s timeout, under the
# 60s Hobby function limit.
CLOUDFLARE_VISION_MODEL="@cf/meta/llama-3.2-11b-vision-instruct"
# Text lookup. llama-3.1-8b-instruct-fast is a current Workers AI model.
# The plain llama-3.1-8b-instruct id is deprecated.
CLOUDFLARE_TEXT_MODEL="@cf/meta/llama-3.1-8b-instruct-fast"

# Optional cloud sync. Leave these unset to keep records on this device only.
# Either complete pair enables Upstash. DATA_STORAGE_ADAPTER is optional.
# The Vercel Marketplace Upstash integration injects the KV_REST_API_* pair.
# KV_REST_API_URL="https://YOUR-INSTANCE.upstash.io"
# KV_REST_API_TOKEN="YOUR_KV_REST_TOKEN"
# UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"
# DATA_STORAGE_ADAPTER=upstash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
