# NVIDIA NIM is the only food-analysis provider. Photo and text requests fail
# with a clear error when both keys below are unset. NVIDIA_DEEPSEEK_API_KEY
# is accepted as an alternate key for the same NVIDIA endpoint.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
# NVIDIA_DEEPSEEK_API_KEY="MY_NVIDIA_API_KEY"
# Text lookup uses Mistral NeMo Minitron 8B, a small non-reasoning instruct
# model. meta/llama-3.1-8b-instruct is no longer on the NVIDIA model list.
# NVIDIA_MODEL="nvidia/mistral-nemo-minitron-8b-8k-instruct"
# NVIDIA_TEXT_TIMEOUT_MS="12000"
# NVIDIA_TEXT_MAX_TOKENS="1200"
# Photo analysis tries models in order. The retired Nano VL 8B and the slow
# Llama 3.2 11B vision model are not in the default chain.
# NVIDIA_VISION_MODELS="minimaxai/minimax-m3.1-flash,meta/muse-glimmer-30b,meta/llama-3.2-90b-vision-instruct"
# NVIDIA_VISION_FALLBACK_MODELS="meta/muse-glimmer-30b,meta/llama-3.2-90b-vision-instruct"
# Per-request cap is 45s (maximum 50s). The whole vision chain defaults to
# 55s so it stays under the 60s function limit. MiniMax needs about 3000
# output tokens because reasoning tokens count toward max_tokens.
# NVIDIA_VISION_TIMEOUT_MS="45000"
# NVIDIA_VISION_TOTAL_TIMEOUT_MS="55000"
# NVIDIA_VISION_MAX_TOKENS="3000"

# Optional cloud sync. Leave these unset to keep records on this device only.
# Either complete pair enables Upstash. DATA_STORAGE_ADAPTER is optional.
# The Vercel Marketplace Upstash integration injects the KV_REST_API_* pair.
# KV_REST_API_URL="https://YOUR-INSTANCE.upstash.io"
# KV_REST_API_TOKEN="YOUR_KV_REST_TOKEN"
# UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"
# DATA_STORAGE_ADAPTER=upstash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
