# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA NIM is used first for food-photo analysis. Models are tried in order;
# the first valid result stops the chain. The default chain is:
# Nano VL 8B -> Llama 3.2 11B Vision -> Llama 3.2 90B Vision.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
# Text lookup uses the faster 8B model by default; set this to override it.
# NVIDIA_MODEL="meta/llama-3.1-8b-instruct"
# NVIDIA_TEXT_TIMEOUT_MS="12000"
# NVIDIA_VISION_MODEL="nvidia/llama-3.1-nemotron-nano-vl-8b-v1"
# NVIDIA_VISION_MODELS="nvidia/llama-3.1-nemotron-nano-vl-8b-v1,meta/llama-3.2-11b-vision-instruct,meta/llama-3.2-90b-vision-instruct"
# NVIDIA_VISION_FALLBACK_MODELS="meta/llama-3.2-11b-vision-instruct,meta/llama-3.2-90b-vision-instruct"
# NVIDIA_VISION_TIMEOUT_MS="15000"
# NVIDIA_VISION_TOTAL_TIMEOUT_MS="40000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
