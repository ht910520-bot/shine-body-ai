# Copy this file to .dev.vars for `pnpm dev` / `pnpm run deploy` local secrets.
# Copy the same keys to .env if you use `pnpm dev:express` or the optional Docker image.
# Never commit .dev.vars or .env. Wrangler reads .dev.vars and ignores .env when both exist.

# Required. Use the existing app password. Do not invent a new one: the login
# cookie is the SHA-256 of this value, and changing it locks out current sessions.
APP_ACCESS_CODE=

# Workers AI model ids. Production defaults also live in wrangler.jsonc `vars`.
# On the Worker, inference uses the AI binding and does not need an API token.
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# CLOUDFLARE_VISION_MAX_TOKENS=2048
# CLOUDFLARE_VISION_TIMEOUT_MS=45000
# CLOUDFLARE_TEXT_MAX_TOKENS=1200
# CLOUDFLARE_TEXT_TIMEOUT_MS=20000

# REST fallback for `pnpm dev:express` and the optional Docker/Railway image only.
# Leave both unset when you are running on Workers with the AI binding.
# CF_ACCOUNT_ID, CF_API_TOKEN, and CLOUDFLARE_AUTH_TOKEN are accepted aliases.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional cloud sync. Leave these unset to keep records on this device only.
# Either complete pair enables Upstash. DATA_STORAGE_ADAPTER is optional.
# When both pairs are set, UPSTASH_REDIS_REST_* wins.
# KV_REST_API_URL=https://YOUR-INSTANCE.upstash.io
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# DATA_STORAGE_ADAPTER=upstash

# Public URL of this app, if you reference it yourself. Not read by the Worker.
APP_URL=
